<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>pe.edu.unsch.pnihce</groupId>
    <artifactId>pni-hce</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>PNI-HCE — Plataforma de Interoperabilidad HCE</name>
    <description>Agregador Maven. Abre este pom.xml en IntelliJ para cargar todos los módulos.</description>

    <!--
        Agregador puro: cada módulo declara spring-boot-starter-parent como su propio padre.
        Este pom solo sirve para que IntelliJ (y `mvn -pl`) descubra los cuatro servicios
        desde la raíz del repositorio.
    -->
    <modules>
        <module>services/mpi</module>
        <module>services/consent</module>
        <module>services/audit</module>
        <module>services/gateway</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- Perfiles de conveniencia para correr tests de todos los módulos a la vez -->
    <profiles>
        <profile>
            <id>all-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.5.3</version>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
